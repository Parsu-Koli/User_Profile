<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - UploadForm Project</title>

    <link rel="icon" href="~/favicon.ico" />

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="bg-light d-flex flex-column min-vh-100">

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark shadow sticky-top custom-navbar">

        <div class="container">

            <a asp-controller="User"
               asp-action="Index"
               class="navbar-brand d-flex align-items-center">

                <div class="brand-logo me-3">

                    <i class="bi bi-cloud-upload-fill fs-3"></i>

                </div>

                <div>

                    <div class="fw-bold fs-5 text-white">
                        Datasphare Innovatives
                    </div>

                    <small class="text-light">
                        Private Limited • Upload Management System
                    </small>

                </div>

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="mainNavbar">

                <ul class="navbar-nav ms-auto align-items-lg-center">

                    <li class="nav-item me-lg-2">

                        <a asp-controller="User"
                           asp-action="Index"
                           class="nav-link">

                            <i class="bi bi-people-fill me-1"></i>

                            Users

                        </a>

                    </li>

                    @* <li class="nav-item">

                        <a asp-controller="User"
                           asp-action="Create"
                           class="btn btn-light rounded-pill px-4">

                            <i class="bi bi-person-plus-fill me-1"></i>

                            Register

                        </a>

                    </li> *@

                </ul>

            </div>

        </div>

    </nav>

    <!-- Main -->
    <main class="container flex-grow-1 py-4">

        @RenderBody()

    </main>

    <!-- Footer -->
    <footer class="custom-footer text-white mt-auto">

        <div class="container py-3">

            <div class="row align-items-center">

                <div class="col-md-6 text-center text-md-start">

                    © @DateTime.Now.Year Datasphare Innovatives Private Limited

                </div>

                <div class="col-md-6 text-center text-md-end">

                    Employee Insight

                </div>

            </div>

        </div>

    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>