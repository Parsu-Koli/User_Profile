@model UploadForm_Project.Models.UserProfile

@{
    ViewData["Title"] = "Register Employee";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-xl-7 col-lg-8 col-md-10">

            <div class="card shadow border-0">

                <div class="card-header text-white"
                     style="background:linear-gradient(90deg,#6f42c1,#d63384);">

                    <div class="d-flex align-items-center">

                        <i class="bi bi-person-workspace fs-2 me-3"></i>

                        <div>

                            <h3 class="mb-0">
                                Employee Registration
                            </h3>

                            <small class="opacity-75">
                                Upload employee work proof
                            </small>

                        </div>

                    </div>

                </div>

                <div class="card-body p-4">

                    <form asp-action="Create"
                          method="post"
                          enctype="multipart/form-data"
                          id="employeeForm">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"></div>

                        <!-- Employee Name -->

                        <div class="mb-4">

                            <label asp-for="FullName"
                                   class="form-label fw-semibold">

                                Employee Name

                            </label>

                            <div class="input-group">

                                <span class="input-group-text">

                                    <i class="bi bi-person-fill"></i>

                                </span>

                                <input asp-for="FullName"
                                       class="form-control"
                                       placeholder="Enter Employee Name" />

                            </div>

                            <span asp-validation-for="FullName"
                                  class="text-danger"></span>

                        </div>

                        <!-- Preview -->

                        <div class="text-center mb-4">

                            <div class="position-relative d-inline-block">

                                <img id="previewImage"
                                     src="https://via.placeholder.com/160?text=Employee"
                                     class="rounded-circle border shadow"
                                     width="160"
                                     height="160"
                                     style="object-fit:cover;" />

                                <button type="button"
                                        class="btn btn-primary rounded-circle position-absolute bottom-0 end-0 shadow"
                                        id="cameraBtn"
                                        style="width:45px;height:45px;">

                                    <i class="bi bi-camera-fill"></i>

                                </button>

                            </div>

                        </div>

                        <!-- Upload -->

                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Upload Work
                            </label>

                            <input asp-for="UploadFile"
                                   id="fileInput"
                                   type="file"
                                   class="d-none" />

                            <div class="row g-2">

                                <div class="col-md-4">
                                    <button type="button"
                                            id="takePhoto"
                                            class="btn btn-primary w-100">
                                        <i class="bi bi-camera-fill me-2"></i>
                                        Camera
                                    </button>
                                </div>

                                <div class="col-md-4">
                                    <button type="button"
                                            id="galleryBtn"
                                            class="btn btn-success w-100">
                                        <i class="bi bi-images me-2"></i>
                                        Gallery
                                    </button>
                                </div>

                                <div class="col-md-4">
                                    <button type="button"
                                            id="zipBtn"
                                            class="btn btn-warning w-100">
                                        <i class="bi bi-file-earmark-zip me-2"></i>
                                        ZIP File
                                    </button>
                                </div>

                            </div>

                            <div class="mt-2">
                                <span id="selectedFile" class="text-muted">
                                    No file selected
                                </span>
                            </div>

                        </div>

                        <div class="modal fade"
                             id="cameraModal"
                             tabindex="-1">

                            <div class="modal-dialog modal-lg modal-dialog-centered">

                                <div class="modal-content">

                                    <div class="modal-header">

                                        <h5 class="modal-title">

                                            <i class="bi bi-camera-fill me-2"></i>

                                            Capture Employee Photo

                                        </h5>

                                        <button class="btn-close"
                                                data-bs-dismiss="modal">
                                        </button>

                                    </div>

                                    <div class="modal-body text-center">

                                        <video id="video"
                                               autoplay
                                               playsinline
                                               class="img-fluid rounded shadow">
                                        </video>

                                        <canvas id="canvas"
                                                class="d-none">
                                        </canvas>

                                    </div>

                                    <div class="modal-footer">

                                        <button class="btn btn-secondary"
                                                data-bs-dismiss="modal">

                                            Cancel

                                        </button>

                                        <button id="captureBtn"
                                                class="btn btn-primary">

                                            <i class="bi bi-camera-fill me-2"></i>

                                            Capture

                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary rounded-pill px-4">

                                <i class="bi bi-arrow-left"></i>

                                Back

                            </a>

                            <button type="submit"
                                    id="saveBtn"
                                    class="btn btn-primary rounded-pill px-4">

                                <span id="btnText">

                                    <i class="bi bi-save-fill"></i>

                                    Save Employee

                                </span>

                                <span id="spinner"
                                      class="spinner-border spinner-border-sm d-none"></span>

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        const preview = document.getElementById("previewImage");
        const fileInput = document.getElementById("fileInput");
        const fileName = document.getElementById("selectedFile");

        const video = document.getElementById("video");
        const canvas = document.getElementById("canvas");

        let stream = null;

        const modal = new bootstrap.Modal(
            document.getElementById("cameraModal")
        );

        document.getElementById("takePhoto").onclick = async function () {

            try {

                stream = await navigator.mediaDevices.getUserMedia({

                    video: {

                        facingMode: "environment"

                    }

                });

                video.srcObject = stream;

                modal.show();

            }

            catch {

                alert("Camera permission denied or camera not available.");

            }

        };

        document.getElementById("galleryBtn").onclick = function () {

            fileInput.accept = "image/*";

            fileInput.removeAttribute("capture");

            fileInput.click();

        };

        document.getElementById("zipBtn").onclick = function () {

            fileInput.accept = ".zip";

            fileInput.click();

        };

        fileInput.onchange = function () {

            const file = this.files[0];

            if (!file)
                return;

            fileName.innerHTML = "<strong>" + file.name + "</strong>";

            if (file.type.startsWith("image")) {

                preview.src = URL.createObjectURL(file);

            }
            else {

                preview.src =
                    "https://cdn-icons-png.flaticon.com/512/4726/4726010.png";

            }

        };

        document.getElementById("captureBtn").onclick = async function () {

            canvas.width = video.videoWidth;

            canvas.height = video.videoHeight;

            canvas.getContext("2d").drawImage(

                video,

                0,

                0,

                canvas.width,

                canvas.height

            );

            canvas.toBlob(function (blob) {

                const file = new File(

                    [blob],

                    "Employee_" + Date.now() + ".jpg",

                    {

                        type: "image/jpeg"

                    }

                );

                const dt = new DataTransfer();

                dt.items.add(file);

                fileInput.files = dt.files;

                preview.src = URL.createObjectURL(file);

                fileName.innerHTML = "<strong>" + file.name + "</strong>";

                modal.hide();

                stream.getTracks().forEach(track => track.stop());

            }, "image/jpeg", 0.95);

        };

        document.getElementById("cameraModal")
        .addEventListener("hidden.bs.modal", function () {

            if (stream) {

                stream.getTracks().forEach(track => track.stop());

            }

        });

        document.getElementById("employeeForm")
        .addEventListener("submit", function () {

            document.getElementById("btnText").classList.add("d-none");

            document.getElementById("spinner").classList.remove("d-none");

        });
    </script>

}